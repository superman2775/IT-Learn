      "id": "q2-404",
      "type": "single-choice",
      "prompt": "What does a 404 status code mean?",
      "options": [
        {
          "id": "a",
          "label": "Server crashed",
          "isCorrect": false
        },
        {
          "id": "b",
          "label": "Not found",
          "isCorrect": true
        },
        {
          "id": "c",
          "label": "Created",
          "isCorrect": false
        },
        {
          "id": "d",
          "label": "Unauthorized",
          "isCorrect": false
        }
      ],
      "explanations": {
        "overview": "404 means the resource was not found.",
        "byOptionId": {
          "a": "Not quite. Server crash is usually 500.",
          "b": "Correct. 404 means not found.",
          "c": "Not quite. Created is 201.",
          "d": "Not quite. Unauthorized is 401."
        }
      }
    },
