        },
        {
          "id": "d",
          "label": "Hosting images",
          "isCorrect": false
        }
      ],
      "explanations": {
        "overview": "OpenAPI is a standard for describing APIs.",
        "byOptionId": {
          "a": "Correct. OpenAPI documents API endpoints.",
