        },
        {
          "id": "c",
          "label": "Color",
          "isCorrect": false
        },
        {
          "id": "d",
          "label": "Title",
          "isCorrect": false
        }
      ],
      "explanations": {
        "overview": "Cursor-based paging works well for infinite lists.",
